---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  .map((p) => {
    const slug = p.id.replace(/\.md$/, "");
    return {
      slug,
      title: p.data.title,
      publishedAt: p.data.publishedAt,
      tags: p.data.tags,
      excerpt: p.data.excerpt ?? p.body.slice(0, 140).replace(/\s+/g, " ").trim(),
      href: `/posts/${slug}/`,
      source: p.data.discussionId ? "discussions" : "issues",
    };
  });

const base = import.meta.env.BASE_URL;
---

<Base title="GitHub を CMS にした Astro ブログ">
  <style>
    .hero {
      text-align: center;
      padding: 2.5rem 0 2rem;
    }

    .hero h1 {
      font-size: clamp(1.9rem, 5vw, 2.8rem);
      margin: 0 0 0.9rem;
      font-weight: 800;
      line-height: 1.35;
      letter-spacing: 0.01em;
    }

    .hero .highlight {
      background: var(--yellow);
      border: 3px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      padding: 0.05em 0.25em;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
    }

    .hero p {
      color: var(--muted);
      max-width: 640px;
      margin: 0 auto;
      font-size: 1.02rem;
    }

    .badges {
      display: flex;
      gap: 0.6rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 1.4rem;
    }

    .badge {
      border: 3px solid var(--border);
      font-weight: 800;
      font-size: 0.82rem;
      padding: 0.25rem 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      box-shadow: 3px 3px 0 var(--border);
    }

    .badge:nth-child(1) {
      background: var(--yellow);
    }
    .badge:nth-child(2) {
      background: var(--blue);
    }
    .badge:nth-child(3) {
      background: var(--pink);
    }
    .badge:nth-child(4) {
      background: var(--green);
    }
    .badge:nth-child(5) {
      background: var(--purple);
    }
    .badge:nth-child(6) {
      background: var(--yellow);
    }

    .section {
      margin: 2.75rem 0;
    }

    .section h2 {
      font-size: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: inline-block;
      background: var(--paper);
      border: 3px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      padding: 0.3rem 0.9rem;
      margin-bottom: 1.4rem;
    }

    .roles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.2rem;
    }

    .role {
      background: var(--paper);
      border: 3px solid var(--border);
      box-shadow: var(--shadow);
      padding: 1.3rem;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .role:hover {
      transform: translate(4px, 4px);
      box-shadow: 1px 1px 0 var(--border);
    }

    .role .emoji {
      font-size: 1.8rem;
    }

    .role h3 {
      margin: 0.6rem 0 0.25rem;
      font-size: 1.15rem;
    }

    .role p {
      margin: 0;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .flow {
      text-align: center;
      font-weight: 800;
      margin-top: 1.4rem;
      color: var(--ink);
      background: var(--yellow);
      border: 3px solid var(--border);
      box-shadow: var(--shadow);
      padding: 0.7rem 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .steps {
      counter-reset: step;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .steps li {
      counter-increment: step;
      position: relative;
      padding: 0.3rem 0 0.3rem 3rem;
      margin-bottom: 0.7rem;
    }

    .steps li::before {
      content: counter(step);
      position: absolute;
      left: 0;
      top: 0.4rem;
      width: 2rem;
      height: 2rem;
      background: var(--pink);
      border: 3px solid var(--border);
      box-shadow: 3px 3px 0 var(--border);
      color: var(--ink);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
    }

    .post-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.2rem;
      padding: 0;
      list-style: none;
    }

    .post-card {
      background: var(--paper);
      border: 3px solid var(--border);
      box-shadow: var(--shadow);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .post-card:hover {
      transform: translate(4px, 4px);
      box-shadow: 1px 1px 0 var(--border);
    }

    .post-card .meta {
      color: var(--muted);
      font-size: 0.8rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      text-transform: uppercase;
    }

    .post-card .title {
      font-size: 1.12rem;
      font-weight: 800;
    }

    .post-card .excerpt {
      color: var(--muted);
      font-size: 0.9rem;
      margin: 0;
    }

    .post-card .more {
      margin-top: auto;
      font-size: 0.9rem;
      display: inline-block;
      align-self: flex-start;
      border: 3px solid var(--border);
      background: var(--blue);
      box-shadow: 3px 3px 0 var(--border);
      padding: 0.2rem 0.7rem;
      font-weight: 800;
    }

    .post-card .more:hover {
      text-decoration: none;
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 var(--border);
    }

    .showcase-note {
      color: var(--muted);
      font-size: 0.95rem;
      margin: -0.5rem 0 1.4rem;
      display: flex;
      gap: 1.1rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .legend {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .legend .swatch {
      width: 0.9rem;
      height: 0.9rem;
      border: 2px solid var(--border);
    }

    .swatch-issues {
      background: var(--blue);
    }

    .swatch-discussions {
      background: var(--pink);
    }

    .post-card.featured {
      grid-column: 1 / -1;
    }

    .post-card .source {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border: 2px solid var(--border);
      box-shadow: 2px 2px 0 var(--border);
      padding: 0.1rem 0.5rem;
    }

    .source-issues {
      background: var(--blue);
    }

    .source-discussions {
      background: var(--pink);
    }

    .featured .title {
      font-size: 1.35rem;
    }

    .featured .excerpt {
      font-size: 1rem;
    }
  </style>

  <section class="hero">
    <h1>
      GitHub Issues / Discussions を<br />
      <span class="highlight">CMS</span> にしたブログ
    </h1>
    <p>
      GitHub の Issue や Discussion を「原稿」として書き、GitHub Actions が自動で Astro
      ブログを生成し、GitHub Pages で公開します。無料・自動化・GitHub 内完結のブログ CMS です。
    </p>
    <div class="badges">
      <span class="badge">GitHub Issues</span>
      <span class="badge">GitHub Discussions</span>
      <span class="badge">Astro</span>
      <span class="badge">GitHub Actions</span>
      <span class="badge">GitHub Pages</span>
      <span class="badge">無料</span>
    </div>
  </section>

  <section class="section">
    <h2>アーキテクチャ</h2>
    <div class="roles">
      <div class="role">
        <div class="emoji">📝</div>
        <h3>原稿</h3>
        <p>GitHub Issues / Discussions に記事を書きます。公開はラベル status:published で制御。</p>
      </div>
      <div class="role">
        <div class="emoji">🏭</div>
        <h3>工場</h3>
        <p>GitHub Actions が公開ラベルの記事を API で取得し、Astro 用 Markdown を生成。</p>
      </div>
      <div class="role">
        <div class="emoji">🛍️</div>
        <h3>店頭</h3>
        <p>Astro が一覧・個別ページを静的生成し、GitHub Pages にデプロイ。</p>
      </div>
    </div>
    <p class="flow">書く → ラベルで公開 → 自動ビルド → Pages で公開</p>
  </section>

  <section class="section">
    <h2>Quickstart</h2>
    <ol class="steps">
      <li>「Use this template」でリポジトリを作成し、<code>astro.config.mjs</code> の <code>site</code> を変更。</li>
      <li>Settings &gt; Pages の Source を <b>GitHub Actions</b> に変更。</li>
      <li>ラベル <code>status:draft</code> / <code>status:published</code> を作成。</li>
      <li>（Discussions 版の場合）Discussions を有効化し <code>blog</code> カテゴリを用意。</li>
      <li><code>status:published</code> ラベルを付けた記事を投稿するだけで公開完了。</li>
    </ol>
  </section>

  <section class="section">
    <h2>Showcase（公開記事）</h2>
    <div class="showcase-note">
      <span class="legend"><span class="swatch swatch-issues"></span> GitHub Issues</span>
      <span class="legend"><span class="swatch swatch-discussions"></span> GitHub Discussions</span>
      <span>両方の入り口から投稿した記事が、1つのサイトに自動で集約されます。</span>
    </div>
    <ul class="post-list">
      {
        posts.map((p, i) => (
          <li class={i === 0 ? "post-card featured" : "post-card"}>
            <span class={`source source-${p.source}`}>
              {p.source === "discussions" ? "Discussions" : "Issues"}
            </span>
            <div class="meta">
              {p.publishedAt}
              {p.tags.length ? ` · ${p.tags.join(", ")}` : ""}
            </div>
            <a class="title" href={`${base}posts/${p.slug}/`}>{p.title}</a>
            <p class="excerpt">{p.excerpt}</p>
            <a class="more" href={`${base}posts/${p.slug}/`}>読む →</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
