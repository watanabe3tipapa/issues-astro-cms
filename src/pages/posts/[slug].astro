---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { GITHUB_DISCUSSIONS_BASE_URL } from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({
    params: { slug: p.id.replace(/\.md$/, "") },
  }));
}

const { slug } = Astro.params;
const all = await getCollection("posts");
const post = all.find((p) => p.id.replace(/\.md$/, "") === slug);

if (!post) {
  throw new Error(`Post not found: ${slug}`);
}

const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.excerpt}>
  <style>
    .back {
      display: inline-block;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      border: 3px solid var(--border);
      background: var(--paper);
      box-shadow: 3px 3px 0 var(--border);
      padding: 0.3rem 0.8rem;
    }

    .back:hover {
      text-decoration: none;
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 var(--border);
    }

    h1 {
      font-size: clamp(1.7rem, 4vw, 2.4rem);
      margin: 0 0 0.5rem;
    }

    .meta {
      color: var(--muted);
      font-size: 0.85rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    .tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.75rem;
    }

    .tag {
      border: 2px solid var(--border);
      background: var(--green);
      box-shadow: 2px 2px 0 var(--border);
      padding: 0.15rem 0.6rem;
      font-size: 0.78rem;
      font-weight: 800;
    }

    .comment-link {
      display: inline-block;
      margin-top: 2.25rem;
      padding: 0.55rem 1rem;
      background: var(--pink);
      border: 3px solid var(--border);
      box-shadow: 4px 4px 0 var(--border);
      font-weight: 800;
    }

    .comment-link:hover {
      text-decoration: none;
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 var(--border);
    }
  </style>

  <a class="back" href={import.meta.env.BASE_URL}>← 一覧に戻る</a>
  <h1>{post.data.title}</h1>
  <div class="meta">{post.data.publishedAt}</div>
  <div class="tags">
    {
      post.data.tags.map((t) => (
        <span class="tag">#{t}</span>
      ))
    }
  </div>

  <article>
    <Content />
  </article>

  {
    post.data.discussionId ? (
      <a
        class="comment-link"
        href={`${GITHUB_DISCUSSIONS_BASE_URL}/${post.data.discussionId}`}
      >
        この記事に GitHub でコメントする →
      </a>
    ) : null
  }
</Base>
