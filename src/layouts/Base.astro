---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const siteDescription = description ?? SITE_DESCRIPTION;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta name="twitter:card" content="summary" />
    <title>{siteTitle}</title>
    <style is:global>
      :root {
        --bg: #f7f4ec;
        --paper: #ffffff;
        --ink: #111111;
        --muted: #57524b;
        --border: #111111;
        --yellow: #ffde59;
        --blue: #7fb2ff;
        --pink: #ff9aa8;
        --green: #a5e6a5;
        --purple: #d3c6ff;
        --shadow: 5px 5px 0 var(--border);
        --maxw: 900px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP",
          system-ui, sans-serif;
        line-height: 1.8;
      }

      a {
        color: var(--ink);
        text-decoration: none;
        font-weight: 700;
      }

      a:hover {
        text-decoration: underline;
        text-decoration-thickness: 3px;
        text-underline-offset: 3px;
      }

      :focus-visible {
        outline: 3px solid var(--border);
        outline-offset: 2px;
      }

      ::selection {
        background: var(--yellow);
        color: var(--ink);
      }

      h1,
      h2,
      h3,
      h4 {
        font-weight: 800;
        line-height: 1.35;
      }

      h1 {
        font-size: 2.2rem;
      }

      h2 {
        font-size: 1.5rem;
        border-bottom: 4px solid var(--border);
        padding-bottom: 0.35rem;
      }

      h3 {
        font-size: 1.15rem;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        background: var(--paper);
        border: 2px solid var(--border);
        padding: 0.1em 0.4em;
        font-size: 0.9em;
      }

      pre {
        background: var(--paper);
        border: 3px solid var(--border);
        box-shadow: var(--shadow);
        padding: 1.1rem;
        overflow-x: auto;
      }

      pre code {
        background: transparent;
        border: none;
        padding: 0;
      }

      img {
        max-width: 100%;
        border: 3px solid var(--border);
        box-shadow: var(--shadow);
      }

      blockquote {
        border-left: 6px solid var(--border);
        margin: 1.5rem 0;
        padding: 0.4rem 1rem;
        background: var(--paper);
        box-shadow: var(--shadow);
        color: var(--muted);
      }

      table {
        border-collapse: collapse;
        width: 100%;
        margin: 1.25rem 0;
      }

      th,
      td {
        border: 2px solid var(--border);
        padding: 0.5rem 0.75rem;
        text-align: left;
      }

      th {
        background: var(--yellow);
      }

      hr {
        border: none;
        border-top: 3px solid var(--border);
        margin: 2rem 0;
      }

      .header {
        border-bottom: 3px solid var(--border);
        background: var(--paper);
        padding: 0.9rem 1.5rem;
        display: flex;
        gap: 0.8rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .header .brand {
        background: var(--yellow);
        border: 3px solid var(--border);
        box-shadow: 3px 3px 0 var(--border);
        padding: 0.35rem 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-right: auto;
      }

      .header .brand:hover {
        text-decoration: none;
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 var(--border);
      }

      .header nav {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .header nav a {
        border: 2px solid var(--border);
        background: var(--bg);
        padding: 0.25rem 0.6rem;
        font-size: 0.85rem;
        box-shadow: 2px 2px 0 var(--border);
      }

      .header nav a:hover {
        text-decoration: none;
        transform: translate(2px, 2px);
        box-shadow: none;
      }

      .container {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 2.25rem 1.25rem 4rem;
      }

      .footer {
        border-top: 3px solid var(--border);
        background: var(--paper);
        color: var(--muted);
        font-size: 0.85rem;
        text-align: center;
        padding: 1.5rem 1rem;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <a class="brand" href={base}>issues-astro-cms</a>
      <nav>
        <a href={base}>LP / 記事一覧</a>
        <a href={`${base}posts/getting-started/`}>セットアップ</a>
        <a href={`${base}posts/architecture/`}>アーキテクチャ</a>
        <a href={`${base}posts/issues-vs-discussions/`}>比較</a>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      GitHub Issues / Discussions を CMS にした Astro ブログ（テンプレート兼教材）
    </footer>
  </body>
</html>
